// Helper — deletes the HDOP blink timer and resets blink state.
// After this call hdopBlinkTimer = nullptr, hdopBlinkPeriod = 0, hdopBlinkState = false.
static void stopHdopBlink() {  /* v1.0.11-NeoGPS CHANGE 3 */
