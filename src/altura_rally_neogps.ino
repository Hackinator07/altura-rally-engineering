    lv_obj_set_style_bg_color(btnMenu,     lv_color_hex(btnPr),  LV_STATE_PRESSED);
    /* v1.0.19-NeoGPS CHANGE 2 — CLR buttons: update base colour; re-init transition
       style so the ease-in animates from the new theme colour.
       No LV_STATE_PRESSED override here — the transition style owns that state.
       lv_obj_remove_style called before re-adding to prevent style-list accumulation
       on repeated theme changes. */
    lv_obj_set_style_bg_color(btnClearOdo, lv_color_hex(t.btn),  0);
    lv_obj_set_style_bg_color(btnClearInt, lv_color_hex(t.btn),  0);
    initClrBtnStyle(t.btn, btnPr);
