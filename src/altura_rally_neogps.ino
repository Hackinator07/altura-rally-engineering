    // Divider
    divMain = lv_obj_create(scr_main);
    lv_obj_set_size(divMain, 320, 2);
    lv_obj_set_pos(divMain, 0, 84);
    lv_obj_set_style_bg_color(divMain, lv_color_hex(0x1A2A6C), 0);
    lv_obj_set_style_border_width(divMain, 0, 0);
    lv_obj_set_style_pad_all(divMain, 0, 0);

